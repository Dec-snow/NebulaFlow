# web-next 环境变量示例
#
# 复制为 .env.local 后按需修改（.env.local 已在仓库根 .gitignore 中忽略）。

# 是否使用本地 mock 数据。
#   未设置 / false → 走真实后端 API（默认）
#   true          → 使用 src/lib/mock.ts 的演示数据，无需后端
VITE_USE_MOCK=false

# 后端基址。留空表示"同源"：
#   - 生产形态（Go 托管 web-next/dist，单端口）留空即可；
#   - `npm run dev` 时 vite.config.ts 已把 /api 代理到 http://localhost:8080，
#     也留空即可；
#   - 只在后端位于其它域名/端口时才需要填，例如 http://127.0.0.1:9000
VITE_API_BASE_URL=

# 应用标题（可选，仅展示用）
VITE_APP_TITLE=NebulaFlow
