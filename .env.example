# NebulaFlow 环境变量配置
# 复制为 .env 后修改即可

# --- 基础 ---
APP_ENV=dev
PORT=8080

# --- 数据库 ---
DATABASE_URL=postgres://nebula:nebula@localhost:5432/nebulaflow?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- 认证 ---
# 生产环境请务必修改：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=72

# --- Provider API Key 加密 ---
# AES-256-GCM 密钥，必须**正好 32 字节**：openssl rand -hex 16（32 个 hex 字符）。
# 非 dev 环境不设置是**致命**配置（服务拒绝启动）——否则 provider api key 明文入库。
# ⚠ 换这个值等于让库里所有已加密的 key 失效：cmd/server 检测到"某条密文解不开"
#   会 fail-closed 直接拒绝启动（而不是把 base64 密文当 Bearer token 发给上游）。
# 服务器上由 deploy/server-setup.sh 生成并写进 /opt/nebulaflow/.env（0600），只生成一次。
ENCRYPTION_KEY=

# --- Worker ---
WORKER_COUNT=20
# 任务消费并发度；<=0 表示跟随 WORKER_COUNT（见 config.Config.ConsumerCount）
CONSUMER_COUNT=0

# --- 执行锁 ---
# task（默认，推荐）/ workflow / off。
# 默认是 task 而不是 workflow：按工作流加锁会把"同一任务不被两个实例重复执行"
# 退化成"整条工作流串行"，受控压测里吞吐从 493.5 掉到 8.9 tasks/s。
WORKFLOW_LOCK_SCOPE=task

# --- 队列 ---
QUEUE_NAME=workflow_tasks
QUEUE_MAXLEN=10000
QUEUE_DLQ_MAXLEN=1000
QUEUE_ADMIT_RATIO=0.8
USE_REDIS_QUEUE=true

# --- 限流 ---
RATE_LIMIT_PER_MIN=120
TASK_RATE_LIMIT_PER_MIN=60
# /api/auth/{register,login} 每分钟每 (IP, 用户名) 的尝试上限。
# 不收口的话撞库只受 bcrypt（约 60ms/次）约束，等于把 auth 包里那套
# 防用户名枚举的时间侧信道缓解整个抵消掉。
AUTH_RATE_LIMIT_PER_MIN=10

# --- 任务 ---
TASK_TIMEOUT_SEC=300
DEFAULT_MAX_RETRY=2

# --- 向量 / Embedding ---
EMBED_DIM=384
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=
# 文档索引并发度：向量化是 CPU + 外部 API 调用密集型，调高会打满 embedding 配额
INDEX_CONCURRENCY=2

# --- 存储模式 ---
# postgres: PostgreSQL + Redis（生产形态）
# memory: 纯内存（演示 / 本地开发 / 零外部依赖）。非 dev 环境下是**致命**配置。
STORAGE_MODE=postgres

# --- 迁移 ---
# 服务启动时自动执行内嵌迁移（含 pgvector 扩展与按 EMBED_DIM 建的 HNSW 索引）。
# 多实例部署时建议改 false，由单独的迁移 job 先跑一遍。
MIGRATE_ON_STARTUP=true

# --- 数据库连接池 ---
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# --- 缓存 ---
WORKFLOW_CACHE_TTL=30s

# --- LLM Mock ---
LLM_MOCK_TOOL_CALL=true

# --- CORS ---
CORS_ORIGINS=*

# --- 全链路 Trace ---
OTEL_ENABLED=false
OTEL_SAMPLE_RATIO=1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_MAX_TRACES=256
OTEL_MAX_SPANS_PER_TRACE=200
