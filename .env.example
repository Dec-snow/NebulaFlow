# NebulaFlow 环境变量配置
# 复制为 .env 后修改即可

# --- 数据库 ---
NEBULA_PG_DSN=postgres://nebula:nebula@localhost:5432/nebula?sslmode=disable

# --- Redis ---
NEBULA_REDIS_ADDR=localhost:6379
NEBULA_REDIS_PASSWORD=

# --- HTTP ---
NEBULA_HTTP_ADDR=:8080
NEBULA_JWT_SECRET=change-me-in-production-please

# --- Worker ---
NEBULA_WORKER_COUNT=8
NEBULA_WORKER_QUEUE_SIZE=256

# --- Logging ---
NEBULA_LOG_LEVEL=info
