# 复制为 .env 并按需修改
APP_ENV=dev
PORT=8080
DATABASE_URL=postgres://nebula:nebula@localhost:5432/nebulaflow?sslmode=disable
# ── 数据库连接池 ────────────────────────────────────────────────
# 为什么必须显式配：pgxpool 的默认值是 max(4, NumCPU)，池大小会随部署机器
# 的核数变化，且与 WORKER_COUNT 毫无关系。同一份代码在 32 核机上池是 32、
# 在 4 核机上池是 4 —— 后者配 20 个 worker 必然全部堵在池上排队。
# 默认值 MinConns=0 还会让池缩到 0，空闲后第一波请求要现付 TCP + 认证握手。
DB_MAX_CONNS=25
# 预热连接数：避免冷启动时现建连接（MinConns > MaxConns 会被 pgxpool 静默钳制，
# 启动日志会给出 WARN）。
DB_MIN_CONNS=5
# 连接最长存活时间：配合 PgBouncer 之类的中间件时需要短于中间件的超时。
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
# 连接超时。不设的话 PG 不可达时实际超时取决于操作系统 TCP 重传（约 2 分钟），
# 表现为请求长时间挂住而不是快速失败。
DB_CONNECT_TIMEOUT=5s
# ── 工作流读缓存 ────────────────────────────────────────────────
# 缓存 GetWorkflow（一次调用内含 3 条查询：工作流行 + 节点 + 边），而每个任务
# 执行都会读一次。0 = 关闭缓存。缓存是进程内的，多实例部署时实例 A 的写
# 不会通知实例 B，必须靠 TTL 兜底，所以 TTL 也是跨实例一致性的上界。
WORKFLOW_CACHE_TTL=30s
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# ── JWT 签名密钥 ────────────────────────────────────────────────
# **非 dev 环境必填**（APP_ENV != dev）。服务启动时会做静态校验，命中任一条就拒绝启动：
#   - 空值
#   - 公开的占位值：change-me / changeme / secret / password / jwt-secret / example …
#     （按**子串**匹配，所以 change-me-in-production-2024 也会被拦）
#   - 长度 < 32 字节（HS256 要求密钥不短于哈希输出长度，RFC 7518 §3.2）
#   - 由同一个字符重复组成（如 32 个 a，长度够但只有 1 字节的熵）
# 生成一个：openssl rand -hex 32
# 留空时：dev 环境退回内置默认值并打 WARN；非 dev 环境直接退出（退出码 1）。
# 部署前可以先干跑一遍：./bin/nebulaflow -check-config
JWT_SECRET=
JWT_EXPIRE_HOURS=72
WORKER_COUNT=20
QUEUE_NAME=workflow_tasks
USE_REDIS_QUEUE=true
# 队列容量水位。注意这是「防止无限增长的护栏」，不是「把队列调小」的旋钮：
# XACK 只把消息移出 PEL、不删消息本体，日常回收靠调度器每 10 秒回收「已确认前缀」；
# 而 MAXLEN 是在 XADD 时裁剪，裁掉的是**尚未投递的最老条目**，会静默丢任务。
# 因此必须 >= 可接受的最大积压，并按 90% 设告警
# （指标 nebulaflow_queue_stream_len / nebulaflow_queue_max_len）。
QUEUE_MAXLEN=10000
QUEUE_DLQ_MAXLEN=1000
# 提交侧背压：XLEN 达到 QUEUE_MAXLEN × 该比例时，POST /api/tasks 直接返回
# 503 + Retry-After，而不是收下之后让 MAXLEN 静默裁掉。
# 为什么准入线（0.8）要低于告警线（0.9）：准入是第一道防线，告警的语义是
# 「第一道防线失效了」。取同一个值会让队列稳定停在阈值上反复穿越，告警变噪声。
# 取值 (0,1)；0 = 用默认 0.8；**负值 = 关闭准入，仅用于压测对照，生产不要用**。
QUEUE_ADMIT_RATIO=0.8
TASK_TIMEOUT_SEC=300
DEFAULT_MAX_RETRY=2
RATE_LIMIT_PER_MIN=60
TASK_RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=*
# postgres（默认，需 PostgreSQL + Redis）/ memory（纯内存，零外部依赖，用于演示与本地开发）
STORAGE_MODE=postgres
# Ollama Embedder 配置（若 DB llm_providers 表有 ollama provider 则优先用其 BaseURL）
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=
# 兜底 Mock Provider 是否具备发起工具调用的能力（Agent 节点用）。
# 仅在"没有配置任何真实 LLM Provider"时才会用到 Mock，也就是演示/离线场景；
# 打开后 Agent 节点（extra.agentic=true）才能在没有 API key 的情况下跑通
# "模型自主调用工具 → 结果回灌 → 给出最终回答"这条链路。
# 不影响未开启 Agent 的节点：请求里没有 tools 时 Mock 行为完全不变。
LLM_MOCK_TOOL_CALL=true
# ── 全链路 Trace（OpenTelemetry）────────────────────────────────
# **默认关闭**。理由不是"开销大"（实测每 span 约 +1.8µs，占一个 agentic 任务的
# 0.07%~0.21%），而是"不改变基线语义"：新功能不能静默改变 P0-0/P0-4 压测数字的含义。
# 打开后 9 类 span（task.create / queue.enqueue / task.execute / node.execute /
# llm.chat / rag.retrieve / tool.call / agent.round / agent.tool）会串成一条链，
# 跨进程那一段靠 queue.Job 里的 W3C traceparent 续接。
OTEL_ENABLED=false
# 采样比例。采样决策只在链路入口做一次、后续进程继承（ParentBased）——
# 每进程各自按比例采样会把一条链采成几截。未采样的链路**依然会传播 traceparent**。
OTEL_SAMPLE_RATIO=1
# 进程内 span 环形缓冲的容量（默认存储后端，离线可查、有容量上界）。
# 一条 trace 超出上限时丢**新到的** span（保留 HTTP 入口 / task.create 这些锚点）。
OTEL_MAX_TRACES=256
OTEL_MAX_SPANS_PER_TRACE=200
# 可选的 OTLP/HTTP 导出（如 Jaeger、Tempo、OTel Collector）。
# **必须带 scheme**（http:// 或 https://），代码会自动剥掉——
# otlptracehttp.WithEndpoint 不接受 scheme，两者混用不会立刻报错，
# 只会在后台批量导出时静默失败（表现为"trace 一条都看不到"）。
# 留空 = 只写进程内环形缓冲。
OTEL_EXPORTER_OTLP_ENDPOINT=
