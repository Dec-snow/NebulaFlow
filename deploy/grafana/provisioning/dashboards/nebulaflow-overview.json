{
  "uid": "nebulaflow-overview",
  "title": "NebulaFlow - System Overview",
  "tags": ["nebulaflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP QPS",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nebulaflow_http_requests_total[1m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running Tasks",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "nebulaflow_workflow_tasks_running",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Workers",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "nebulaflow_worker_active",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker Queue Size",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "nebulaflow_worker_queue_size",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Latency P95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nebulaflow_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Task Duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(nebulaflow_workflow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(nebulaflow_workflow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM Requests by Provider",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(nebulaflow_llm_requests_total[1m])) by (provider, result)",
          "legendFormat": "{{provider}} {{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token Usage (out)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(nebulaflow_llm_tokens_total{direction=\"out\"}[1m])) by (provider)",
          "legendFormat": "{{provider}} out"
        }
      ]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Task Outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum(increase(nebulaflow_workflow_tasks_total[1h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
